<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PvPmo"
             xmlns:conv="clr-namespace:PvPmo.Util"             
             x:Class="PvPmo.App">
    
    <Application.Resources>         

        <ResourceDictionary>            

            <conv:InverseBoolConverter x:Key="InverseBoolConverter" />

            <!-- DataTemplate per FileSetupConfig -->
            <DataTemplate x:Key="FileSetupConfigTemplate">
                <Border Style="{StaticResource ConfigBorderStyle}">
                    <Grid ColumnDefinitions="Auto,*,*,*" 
                          RowDefinitions="Auto,Auto" 
                          Padding="10"
                          ColumnSpacing="10"
                          RowSpacing="5">

                        <!-- Intestazioni -->
                        <Label Grid.Row="0" Grid.Column="0" 
                               Text="Id" 
                               Style="{StaticResource ConfigIntestazioneCol}"/>
                        <Label Grid.Row="0" Grid.Column="1" 
                               Text="File Import" 
                               Style="{StaticResource ConfigIntestazioneCol}"/>
                        <Label Grid.Row="0" Grid.Column="2" 
                               Text="Tab. Destinazione" 
                               Style="{StaticResource ConfigIntestazioneCol}"/>
                        <Label Grid.Row="0" Grid.Column="3" 
                               Text="Descrizione" 
                               Style="{StaticResource ConfigIntestazioneCol}"/>

                        <!-- Valori -->
                        <Label Grid.Row="1" Grid.Column="0" 
                               Text="{Binding Id}" 
                               Style="{StaticResource ConfigStileCol}"/>
                        <Entry Grid.Row="1" Grid.Column="1" 
                               Text="{Binding FileImp}" 
                               Placeholder="Nome file"/>
                        <Entry Grid.Row="1" Grid.Column="2" 
                               Text="{Binding TabDest}" 
                               Placeholder="Tabella destinazione"/>
                        <Entry Grid.Row="1" Grid.Column="3" 
                               Text="{Binding Descrizione}" 
                               Placeholder="Descrizione"/>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- ConfigTemplateSelector -->
            <conv:ConfigTemplateSelector x:Key="ConfigTemplateSelector"
                                         DefaultTemplate="{StaticResource FileSetupConfigTemplate}"/>
            
            <Color x:Key="Primary">#FFC107</Color>
            <Color x:Key="PrimaryDark">#FFA000</Color>
            <Color x:Key="Accent">#00BCD4</Color>
            <Color x:Key="Dark">Black</Color>
            <Color x:Key="BlueViolet">BlueViolet</Color>            

            <Color x:Key="LightBackground">#FAF9F8</Color>
            <Color x:Key="DarkBackground">Black</Color>
            <Color x:Key="GialloVerde">YellowGreen</Color>

            <Style x:Key="ConfigIntestazioneCol" TargetType="Label">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="Red" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="HorizontalOptions" Value="Center" />                
            </Style>

            <Style x:Key="ConfigStileCol" TargetType="Label">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="BlueViolet" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="HorizontalOptions" Value="Center" />                
            </Style>

            <Style x:Key="ConfigStilePick" TargetType="DatePicker">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="BlueViolet" />                
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>

            <Style x:Key="ConfigBorderStyle" TargetType="Border">
                <Setter Property="Stroke" Value="LightGray" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Background" Value="{AppThemeBinding Light='White', Dark='lightgrey'}" />
                <Setter Property="Padding" Value="5" />
                <Setter Property="Margin" Value="4" />
                <Setter Property="StrokeShape">
                    <RoundRectangle CornerRadius="8"/>
                </Setter>
            </Style>

            <Style TargetType="Page" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor"
                Value="{StaticResource LightBackground}" />
            </Style>

            <Style ApplyToDerivedTypes="True" TargetType="NavigationPage">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}" />
                <Setter Property="BarBackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="BarTextColor" Value="White" />
            </Style>

            <Style TargetType="Label" x:Key="BaseLabel">
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="TextColor" Value="#1F1F1F" />
            </Style>

            <Style x:Key="MicroLabel" BasedOn="{StaticResource BaseLabel}" TargetType="Label">
                <Setter Property="FontSize" Value="10"/>
            </Style>

            <Style x:Key="SmallLabel" BasedOn="{StaticResource BaseLabel}" TargetType="Label">
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="MediumLabel" BasedOn="{StaticResource BaseLabel}" TargetType="Label">
                <Setter Property="FontSize" Value="16"/>
            </Style>

            <Style x:Key="LargeLabel" BasedOn="{StaticResource BaseLabel}" TargetType="Label">
                <Setter Property="FontSize" Value="20"/>
            </Style>

            <Style TargetType="RefreshView" ApplyToDerivedTypes="True">
                <Setter Property="RefreshColor" Value="{StaticResource Primary}" />
            </Style>

            <Style x:Key="MyButton" TargetType="Button">
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="Black"
                            Radius="8"
                            Offset="2,2"
                            Opacity="1" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Background" Value="{StaticResource GialloVerde}"/>
                <Setter Property="TextColor" Value="{StaticResource Dark}" />
                <Setter Property="BorderColor" Value="{StaticResource Primary}" />
                <Setter Property="BorderWidth" Value="4" />
                <Setter Property="HeightRequest" Value="50" />
                <Setter Property="CornerRadius" Value="20" />
            </Style>

            <Style x:Key="MyEntry" TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource Dark}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource BlueViolet}" />
                <Setter Property="HeightRequest" Value="50" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="BackgroundColor" Value="{StaticResource GialloVerde}" />
                <Setter Property="Margin" Value="0,5" />
                <Setter Property="WidthRequest" Value="420" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="Black"
                            Radius="8"
                            Offset="2,2"
                            Opacity="1" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MyProgressBar" TargetType="ProgressBar">
                <Setter Property="HeightRequest" Value="20" />
                <Setter Property="BackgroundColor" Value="#EEEEEE" />
                <Setter Property="ProgressColor" Value="red" />                
                <Setter Property="Margin" Value="10" />
                <Setter Property="HorizontalOptions" Value="Fill" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="ButtonOutline" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource LightBackground}"/>
                <Setter Property="TextColor" Value="{StaticResource Primary}"/>
                <Setter Property="BorderColor" Value="{StaticResource Primary}"/>
                <Setter Property="BorderWidth" Value="2"/>
                <Setter Property="HeightRequest" Value="40"/>
                <Setter Property="CornerRadius" Value="20"/>
            </Style>
            
            <Style x:Key="CardView" TargetType="Border">
                <Setter Property="Stroke" Value="#DDDDDD" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10"/>
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="{StaticResource LightBackground}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>       
</Application>
