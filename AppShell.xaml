<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PvPmo.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:view="clr-namespace:PvPmo.View"
    Shell.FlyoutBehavior="Disabled">

    <ShellContent        
        ContentTemplate="{DataTemplate view:LoginView}"
        Route="LoginView" />
    <ShellContent        
        ContentTemplate="{DataTemplate view:MainPageView}"
        Route="MainPageView" />
    <ShellContent        
        ContentTemplate="{DataTemplate view:ModDataView}"
        Route="ModDataView" />
    <ShellContent        
        ContentTemplate="{DataTemplate view:GesAcsView}"
        Route="GesAcsView" />
</Shell>
