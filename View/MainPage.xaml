<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PvPmo.View.MainPage"
             xmlns:viewmodel="clr-namespace:PvPmo.ViewModel"
             x:DataType="viewmodel:MainViewModel"
             Title="{Binding Title}">     

    <RefreshView Command="{Binding IsRefreshing}">
        
        <Grid
            ColumnDefinitions="*,*,*"             
            RowDefinitions="*,*,*"
            RowSpacing="0">

            <Image x:Name="backgroundImage"
                   Source="wallpaper_dl.png"
                   Grid.RowSpan="3"
                   Grid.ColumnSpan="3"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Aspect="AspectFill" />

            <Button Text="Gestione Importazioni Dati Acs ed Exl."
                    Style="{StaticResource MyButton}"
                    Command="{Binding BtnGesAcsCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="40"/>

            <Button Text="Aggiornamento mensile Data Base."
                    Style="{StaticResource MyButton}"
                    Command="{Binding BtnAgDbCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="40"/>
            
            <Button Text="Aggiornamento tabella Date."
                    Style="{StaticResource MyButton}"
                    Command="{Binding BtnAgDataCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="40"/>

            <Button Text="TEST."
                    Style="{StaticResource MyButton}"
                    Command="{Binding BtnTestCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="40"/>
            
            <Button Text="Chiudi ed Esci."
                    Style="{StaticResource MyButton}"
                    Command="{Binding BtnEndCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Grid.Row="2"
                    Grid.Column="2"
                    Margin="40"/>

            <!--<StackLayout Orientation="Horizontal"
                         Grid.Row="3"
                         Grid.ColumnSpan="3"
                         Padding="10"
                         Spacing="10"
                         BackgroundColor="{StaticResource LightBackground}"
                         IsVisible="{Binding IsProgressVisible}">

                <ProgressBar Progress="{Binding ProgressValue}"
                             HeightRequest="20"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"/>

                <Label Text="{Binding ProgressText}"
                       FontSize="14"
                       VerticalOptions="Center"
                       Margin="10,0,0,0"/>

                <Label Text="{Binding TabellaCorrente}"
                       FontSize="14"
                       VerticalOptions="Center"
                       HorizontalOptions="Start"
                       Margin="0,0,10,0"/>

            </StackLayout>-->

            <ActivityIndicator  IsVisible="{Binding IsBusy}"
                                IsRunning="{Binding IsBusy}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"                              
                                Grid.RowSpan="2"
                                Grid.ColumnSpan="2"/>
        </Grid>
    </RefreshView>
</ContentPage>
