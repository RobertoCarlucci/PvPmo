<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PvPmo.View.ModData"
             xmlns:viewmodel="clr-namespace:PvPmo.ViewModel"
             x:DataType="viewmodel:ModDataViewModel"
             Title="{Binding Title}">
    
    <VerticalStackLayout>
        <Grid>
            <Image x:Name="backgroundImage"
                    Source="wallpaper_dl.png"
                    Grid.RowSpan="3"
                    Grid.ColumnSpan="3"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand"
                    Aspect="AspectFill"/>
        </Grid>
    </VerticalStackLayout>
</ContentPage>