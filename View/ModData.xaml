<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PvPmo.View.ModData"
             xmlns:viewmodel="clr-namespace:PvPmo.ViewModel"
             x:DataType="viewmodel:ModDataViewModel"
             Title="{Binding Title}">

    <VerticalStackLayout>
        <Grid 
            ColumnDefinitions="*,*,*"             
            RowDefinitions="*,*,*"
            RowSpacing="0">

            <Button Text="Aggiorna Data."
                    Style="{StaticResource MyButton}"
                    Command="{Binding BtnAnnullaEsciCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="40"/>

            <Button Text="Annulla ed Esci."
                    Style="{StaticResource MyButton}"
                    Command="{Binding BtnSalvaEsciCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="40"/>

            <Image x:Name="backgroundImage"
                    Source="wallpaper_dl.png"
                    Grid.RowSpan="3"
                    Grid.ColumnSpan="3"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand"
                    Aspect="AspectFill"/>
        </Grid>
    </VerticalStackLayout>
</ContentPage>