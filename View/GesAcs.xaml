<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PvPmo.View.GesAcs"              
             xmlns:viewmodel="clr-namespace:PvPmo.ViewModel"
             x:DataType="viewmodel:GesAcsViewModel"
             Title="{Binding Title}">

    <RefreshView Command="{Binding IsRefreshing}">
        <Grid 
            ColumnDefinitions="*,*,*"             
            RowDefinitions="*,*,*"
            RowSpacing="0">

            <Image x:Name="backgroundImage"
                Source="wallpaper_dl.png"
                Grid.RowSpan="3"
                Grid.ColumnSpan="3"
                HorizontalOptions="CenterAndExpand"
                VerticalOptions="CenterAndExpand"
                Aspect="AspectFill"/>

            <Button Text="Importa Dati Access."
                Style="{StaticResource MyButton}"
                Command="{Binding BtnImpAcsCommand}"
                IsEnabled="{Binding IsNotBusy}"
                Grid.Row="0"
                Grid.Column="0"
                Margin="40"/>
            
            <Button Text="Torna Home Page."
                Style="{StaticResource MyButton}"
                Command="{Binding BtnAnnullaEsciCommand}"
                IsEnabled="{Binding IsNotBusy}"
                VerticalOptions="Center"
                Grid.Row="3"
                Grid.Column="3"
                Margin="40"/>
            
            <ActivityIndicator IsVisible="{Binding IsBusy}"
                IsRunning="{Binding IsBusy}"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="CenterAndExpand"                               
                Grid.RowSpan="2"
                Grid.ColumnSpan="2"/>

        </Grid>
    </RefreshView>
</ContentPage>