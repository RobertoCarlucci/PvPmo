<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PvPmo.View.JsonEditorView"
             xmlns:viewmodel="clr-namespace:PvPmo.ViewModel"
             xmlns:models="clr-namespace:PvPmo.Models"
             x:DataType="viewmodel:JsonEditorViewModel"
             Title="{Binding Title}">
    <Grid ColumnDefinitions="*,*"   
      RowDefinitions="*,*,*"   
      RowSpacing="0">

        <Image x:Name="backgroundImage"  
            Source="wallpaper_dl.png"  
            Grid.RowSpan="3"  
            Grid.ColumnSpan="2"  
            HorizontalOptions="Center"  
            VerticalOptions="Center"  
            Aspect="AspectFill"/>

        <VerticalStackLayout Padding="10"   
                         Spacing="10"  
                         Grid.Column="1"  
                         Grid.RowSpan="3">

            <Label Text="Configurazioni JSON"   
               FontAttributes="Bold"   
               FontSize="30"   
               TextColor="Gray "   
               HorizontalTextAlignment="Center"/>

            <Border Stroke="DarkGray" Padding="10">
                <CollectionView ItemsSource="{Binding TipiDisponibili}" SelectionMode="Single"                                >
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ConfigOption">
                            <Border Padding="10" Margin="5" Stroke="DarkGray" BackgroundColor="Transparent">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:JsonEditorViewModel}}
                                    , Path=ApriEditorCommand}" 
                                    CommandParameter="{Binding}" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout>
                                    <Label Text="{Binding TitoloConfig}" FontAttributes="Bold" FontSize="18" TextColor="Red" />
                                    <Label Text="{Binding Descrizione}" FontSize="14" TextColor="Fuchsia" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>                        
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </VerticalStackLayout>        

        <Button Text="Esci senza modifiche"                    
            Style="{StaticResource MyButton}"    
            Command="{Binding BtnAnnullaEsciCommand}"  
            VerticalOptions="Center"  
            Grid.Row="1"  
            Grid.Column="0"  
            Margin="40"/>

    </Grid>
</ContentPage>