<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:PvPmo.ViewModel"
    xmlns:models="clr-namespace:PvPmo.Models"
    x:DataType="viewmodel:EditorConfigViewModel"
    x:Class="PvPmo.View.EditorConfigView"
    Title="{Binding Title}">

    <Grid
        ColumnDefinitions="*,*,*"           
        RowSpacing="0">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>


        <Image  x:Name="backgroundImage"
                Source="wallpaper_dl.png"
                Grid.RowSpan="4"
                Grid.ColumnSpan="3"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Aspect="AspectFill" />

        <!-- Contenuto -->

        <Button Text="Finalizza"
                Command="{Binding SalvaCommand}"
                Style="{StaticResource MyButton}" 
                VerticalOptions="Center"  
                Grid.Row="0"  
                Grid.Column="0"                
                Margin="40"/>

        <Button Text="Normalizza"
                Command="{Binding SalvaCommand}"
                Style="{StaticResource MyButton}" 
                VerticalOptions="Center"  
                Grid.Row="1"  
                Grid.Column="0"                
                Margin="40"/>

        <Button Text="Origine"
                Command="{Binding SalvaCommand}"
                Style="{StaticResource MyButton}" 
                VerticalOptions="Center"  
                Grid.Row="2"  
                Grid.Column="0"                
                Margin="40"/>

        <Button Text="Progress"
                Command="{Binding SalvaCommand}"
                Style="{StaticResource MyButton}" 
                VerticalOptions="Center"  
                Grid.Row="0"  
                Grid.Column="1"                
                Margin="40"/>

        <Button Text="Utente"
                Command="{Binding SalvaCommand}"
                Style="{StaticResource MyButton}" 
                VerticalOptions="Center"  
                Grid.Row="1"  
                Grid.Column="1"                
                Margin="40"/>

        <Button Text="File Setup"
                Command="{Binding ApriFileSetupConfigCommand}"
                Style="{StaticResource MyButton}" 
                VerticalOptions="Center"  
                Grid.Row="2"  
                Grid.Column="1"                
                Margin="40"/>

        <Button Text="Torna"
                Command="{Binding BtnAnnullaEsciCommand}"
                Style="{StaticResource MyButton}"
                VerticalOptions="Center"  
                Grid.Row="2"  
                Grid.Column="2"                
                Margin="40"/>
        
    </Grid>
</ContentPage>
