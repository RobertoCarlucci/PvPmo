<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:models="clr-namespace:PvPmo.Models">

    <DataTemplate x:Key="UtenteTemplate" x:DataType="models:Utente">
        <Border Style="{StaticResource ConfigBorderStyle}">
            <HorizontalStackLayout Spacing="5">
                <Label Text="Nome utente:" Style="{StaticResource ConfigIntestazioneCol}" />
                <Entry Text="{Binding NomeUtente}" Style="{StaticResource MyEntry}" />

                <Label Text="Password:" Style="{StaticResource ConfigIntestazioneCol}" />
                <Entry Text="{Binding PasswordHash}" Style="{StaticResource MyEntry}" />

                <Label Text="Ruolo:" Style="{StaticResource ConfigIntestazioneCol}" />
                <Entry Text="{Binding Ruolo}" Style="{StaticResource MyEntry}" />

                <Label Text="Locale/Rete:" Style="{StaticResource ConfigIntestazioneCol}" />
                <Entry Text="{Binding Tipo}" Style="{StaticResource MyEntry}" />
            </HorizontalStackLayout>
        </Border>
    </DataTemplate>

</ResourceDictionary>
